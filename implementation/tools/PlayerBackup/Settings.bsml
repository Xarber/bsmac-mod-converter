<scrollable-settings-container>
  <vertical spacing="2">
    <text text="X-Center ID" font-size="4" />
    <text text="~account-status" font-size="3" />
    <horizontal spacing="2">
      <button text="Sign in" on-click="sign-in" />
      <button text="Cancel sign-in / Sign out" on-click="sign-out" />
    </horizontal>
    <horizontal spacing="2">
      <button text="Upload this version" on-click="upload" />
      <button text="Download this version" on-click="download" />
    </horizontal>
    <text text="~queue-status" font-size="3" />
    <toggle-setting text="Player data" value="player" apply-on-change="true" />
    <toggle-setting text="Plugin configs" value="configs" apply-on-change="true" />
    <toggle-setting text="Mods" value="mods" apply-on-change="true" />
    <toggle-setting text="Maps" value="maps" apply-on-change="true" />
    <toggle-setting text="Models" value="models" apply-on-change="true" />
    <button text="Back up after exit" on-click="backup" />
    <button text="Restore selected items after exit" on-click="restore" />
    <button text="Cancel queued operation" on-click="cancel" />
    <text text="Local backups by game version" font-size="4" />
    <text text="~history" font-size="3" />
    <button text="Refresh backup list" on-click="refresh-history" />
  </vertical>
</scrollable-settings-container>
